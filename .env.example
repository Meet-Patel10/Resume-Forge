# ===== AI Provider: Amazon Bedrock =====
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-2

# Environment: "production" or "testing"
APP_ENV=testing

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=True

# Database (Neon PostgreSQL — hosted)
DATABASE_URL=postgresql://username:password@your-endpoint.neon.tech/neondb?sslmode=require
